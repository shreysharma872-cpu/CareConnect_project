# App
NEXT_PUBLIC_APP_NAME=CareConnect
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (local example; create the database first)
DATABASE_URL=postgres://postgres:your-password@localhost:5432/careconnect
RUST_BACKEND_PORT=4000
RUST_BACKEND_URL=http://127.0.0.1:4000

# Required in production; use unique random secrets
SESSION_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-another-long-random-secret
ENABLE_IN_APP_REMINDER_SCHEDULER=false

# Optional email delivery. Resend uses HTTPS and works on Render's free tier.
# Configure a verified sender domain before using a production sender address.
RESEND_API_KEY=
EMAIL_FROM="CareConnect <onboarding@resend.dev>"

# Optional local Gmail SMTP fallback (blocked from Render free services)
EMAIL_USER=
EMAIL_PASS=
